{
  // Deploy do Nexus Hub no Cloudflare Workers.
  //
  // O build do TanStack Start (nitro, preset cloudflare) produz:
  //   dist/server/server.js  -> o Worker
  //   dist/client/           -> os arquivos estáticos
  //
  // Segredos NÃO ficam aqui. SUPABASE_SERVICE_ROLE_KEY entra por
  // `wrangler secret put`. As VITE_* são embutidas no build, não em runtime.
  //
  // Passo a passo em docs/DEPLOY.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexus-hub-oem",
  "main": "dist/server/server.js",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    // Públicos/não sensíveis. O que é segredo vai por `wrangler secret put`.
    "SUPABASE_URL": "https://furohpfhukwajhvnnbiw.supabase.co",
    "SUPABASE_PROJECT_ID": "furohpfhukwajhvnnbiw",
    "SUPABASE_PUBLISHABLE_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZ1cm9ocGZodWt3YWpodm5uYml3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODA5NzMxOTYsImV4cCI6MjA5NjU0OTE5Nn0.5qXujfD16TtztaEL3lrp7fbwzhjypAZgBgvXzlILPgE",

    // O host de leitura só é usado pelo caminho de ESCRITA (que monta o corpo
    // do update com a lista completa de módulos). A carga em si roda na edge
    // function, dentro do Supabase — o Worker não fala com o OEM para ler.
    "OEM_API_LEITURA_URL": "https://api.tabletcloud.com.br",

    // Trava de escrita no OEM. Enquanto for diferente de "true", o sistema
    // apenas LÊ do OEM — bloquear/desbloquear e ativar/desativar recusam.
    "OEM_ESCRITA_HABILITADA": "false"
  }
}
